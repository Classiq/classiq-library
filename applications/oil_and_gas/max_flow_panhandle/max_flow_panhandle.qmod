qfunc mixer_layer(beta: real, y: qnum<3, UNSIGNED, 0>[5]) {
  apply_to_all(lambda(q) {
    RX(0.1 * beta, q);
  }, y);
}

qfunc main(params: real[60], output y: qnum<3, UNSIGNED, 0>[5]) {
  allocate(y);
  hadamard_transform(y);
  repeat (i: 30) {
    cost_layer(params[2 * i], y);
    mixer_layer(params[(2 * i) + 1], y);
  }
}
