qfunc Wj_circuit_expanded___0(theta: real, lam: real, xgate: int, qbits: qbit[1]) {
  within {
    invert {
      Bj_expanded___0(lam, qbits);
    }
    change_control_condition_expanded___0(xgate, qbits);
  } apply {
    my_mcrz_expanded___0(theta, qbits);
  }
}

