qfunc qft_no_swap_expanded___0(qbv: qbit[3]) {
  repeat (i: 3) {
    H(qbv[i]);
    repeat (j: (3 - i) - 1) {
      CPHASE(pi / (2 ** (j + 1)), qbv[(i + j) + 1], qbv[i]);
    }
  }
}

qfunc qft_expanded___0(target: qbit[3]) {
  repeat (index: 1) {
    SWAP(target[index], target[2 - index]);
